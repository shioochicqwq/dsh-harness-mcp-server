    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "cordis",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shioochicqwq/dsh-harness-mcp-server.git"
  },
  "homepage": "https://github.com/shioochicqwq/dsh-harness-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/shioochicqwq/dsh-harness-mcp-server/issues"
  },
  "dsh": {
    "bundle": {
